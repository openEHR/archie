template (adl_version=2.4.0; rm_release=1.1.0)
    openEHR-EHR-OBSERVATION.attemplate.v1.0.0

specialize
    openEHR-EHR-OBSERVATION.atbp-child.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Test">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"Template">
        >
    >

definition
    OBSERVATION[at0000.1.1] matches {    -- BP template
        /data[at0001]/events[at0002]/data[at0003]/items matches {
            use_archetype CLUSTER[at0014.0.1, openEHR-EHR-CLUSTER.ovl-atdevice-001.v1.0.0] occurrences matches {0..1}
            ELEMENT[at0005] occurrences matches {0}
            ELEMENT[at0.0.1] occurrences matches {0..1} matches {    -- Template comment
                value matches {
                    DV_TEXT[at0.0.2]
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000.1.1"] = <text = <"BP template"> description = <"BP template">>
            ["at0014.0.1"] = <text = <"Device (filled)"> description = <"Device (filled)">>
            ["at0.0.1"] = <text = <"Template comment"> description = <"Template comment">>
            ["at0.0.2"] = <text = <"Template comment value"> description = <"Template comment value">>
        >
    >

---------------------------------------------------------------------------------
template_overlay
    openEHR-EHR-CLUSTER.ovl-atdevice-001.v1.0.0

specialize
    openEHR-EHR-CLUSTER.atdevice.v1.0.0

definition
    CLUSTER[at0000.1] matches {    -- Device overlay
        items matches {
            ELEMENT[at0001] occurrences matches {1}
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000.1"] = <text = <"Device overlay"> description = <"Device overlay">>
        >
    >
