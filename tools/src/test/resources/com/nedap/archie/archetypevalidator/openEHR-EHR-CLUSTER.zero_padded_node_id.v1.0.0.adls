archetype (adl_version=2.4.0; rm_release=1.1.0)
    openEHR-EHR-CLUSTER.zero_padded_node_id.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Test">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"Id-coded archetype with a zero-padded node id that needs no term">
        >
    >

definition
    CLUSTER[id1] matches {    -- Root
        items matches {
            ELEMENT[id2] occurrences matches {0..1} matches {    -- Element
                value matches {
                    DV_CODED_TEXT[id03] matches {
                        defining_code matches {[at4]}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"Root"> description = <"Root">>
            ["id2"] = <text = <"Element"> description = <"Element">>
            ["at4"] = <text = <"Value"> description = <"Value">>
        >
    >
