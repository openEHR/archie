archetype (adl_version=2.4.0; rm_release=1.1.0)
    openEHR-EHR-OBSERVATION.atbp.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Test">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"Test at-coded archetype with rules">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- BP
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- systolic
                                        value matches {
                                            DV_QUANTITY[at0010] matches {
                                                [magnitude, units, precision] matches {
                                                    [{|0.0..<1000.0|}, {"mm[Hg]"}, {1}]
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- diastolic
                                        value matches {
                                            DV_QUANTITY[at0011] matches {
                                                [magnitude, units, precision] matches {
                                                    [{|0.0..<1000.0|}, {"mm[Hg]"}, {1}]
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0006] occurrences matches {0..1} matches {    -- position
                                        value matches {
                                            DV_CODED_TEXT[at0012] matches {
                                                defining_code matches {[ac0001]}
                                            }
                                        }
                                    }
                                    ELEMENT[at0009] occurrences matches {0..1} matches {    -- difference
                                        value matches {
                                            DV_QUANTITY[at0013] matches {
                                                [magnitude, units, precision] matches {
                                                    [{|0.0..<1000.0|}, {"mm[Hg]"}, {1}]
                                                }
                                            }
                                        }
                                    }
                                    allow_archetype CLUSTER[at0014] occurrences matches {0..*} matches {    -- device
                                        include
                                            archetype_id/value matches {/.*/}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

rules
    $systolic:Real ::= /data[at0001]/events[at0002]/data[at0003]/items[at0004]/value/magnitude
    $diastolic:Real ::= /data[at0001]/events[at0002]/data[at0003]/items[at0005]/value/magnitude
    difference: /data[at0001]/events[at0002]/data[at0003]/items[at0009]/value/magnitude = $systolic - $diastolic
    position_exists: exists /data[at0001]/events[at0002]/data[at0003]/items[at0006]

terminology
    term_definitions = <
        ["en"] = <
            ["at0000"] = <text = <"BP"> description = <"BP">>
            ["at0001"] = <text = <"history"> description = <"history">>
            ["at0002"] = <text = <"Any event"> description = <"Any event">>
            ["at0003"] = <text = <"tree"> description = <"tree">>
            ["at0004"] = <text = <"Systolic"> description = <"Systolic">>
            ["at0005"] = <text = <"Diastolic"> description = <"Diastolic">>
            ["at0006"] = <text = <"Position"> description = <"Position">>
            ["at0007"] = <text = <"Standing"> description = <"Standing">>
            ["at0008"] = <text = <"Sitting"> description = <"Sitting">>
            ["at0009"] = <text = <"Difference"> description = <"Difference">>
            ["at0010"] = <text = <"q"> description = <"q">>
            ["at0011"] = <text = <"q"> description = <"q">>
            ["at0012"] = <text = <"c"> description = <"c">>
            ["at0013"] = <text = <"q"> description = <"q">>
            ["at0014"] = <text = <"Device"> description = <"Device">>
            ["ac0001"] = <text = <"Position values"> description = <"Position values">>
        >
    >
    term_bindings = <
        ["SNOMED-CT"] = <
            ["at0004"] = <http://snomed.info/id/271649006>
            ["/data[at0001]/events[at0002]/data[at0003]/items[at0005]"] = <http://snomed.info/id/271650006>
        >
    >
    value_sets = <
        ["ac0001"] = <
            id = <"ac0001">
            members = <"at0007", "at0008">
        >
    >
