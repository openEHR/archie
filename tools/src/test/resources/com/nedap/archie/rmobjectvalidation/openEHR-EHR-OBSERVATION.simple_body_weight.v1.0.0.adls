archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-EHR-OBSERVATION.simple_body_weight.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    lifecycle_state = <"draft">

definition
    OBSERVATION[id1] matches {    -- Simple body weight
        data matches {
            HISTORY[id2] matches {
                events cardinality matches {1; unordered} matches {
                    EVENT[id3] matches {    -- Any event
                        data existence matches {1} matches {
                            ITEM_TREE[id4] matches {
                                items cardinality matches {1..*; unordered} matches {
                                    ELEMENT[id5] occurrences matches {1} matches {    -- Weight
                                        value matches {
                                            DV_QUANTITY[id9002] matches {
                                                [magnitude, units] matches {
                                                    [{|0.0..1000.0|}, {"kg"}],
                                                    [{|0.0..2000.0|}, {"[lb_av]"}],
                                                    [{|0.0..1000000.0|}, {"g"}]
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <
                text = <"Simple body weight">
                description = <"Measurement of the body weight of an individual.">
            >
            ["id3"] = <
                text = <"Any event">
                description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
            >
            ["id5"] = <
                text = <"Weight">
                description = <"The weight of the individual.">
            >
        >
    >
